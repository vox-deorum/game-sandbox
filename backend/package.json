{
  "name": "@game-sandbox/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Game Sandbox backend: sessions, the execution driver, and the WebSocket bridge between container and browser.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build:image": "tsx src/build-image.ts",
    "check": "biome check . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.2.0",
    "@game-sandbox/schema": "*",
    "better-auth": "1.6.23",
    "better-sqlite3": "^12.10.0",
    "dockerode": "^4.0.12",
    "fastify": "^5.8.0",
    "kysely": "^0.29.2",
    "openai": "^6.47.0",
    "simple-git": "^3.36.0",
    "tar-fs": "^2.1.4",
    "tiktoken": "^1.0.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.10.0",
    "@types/tar-fs": "^2.0.4",
    "@types/ws": "^8.5.13",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  }
}
