# Top-level dependency intents for template-v1 — the source of truth for the dependency set.
# This is the single global dependency set, shared by every environment template layer (the
# union of what all environments need); there is one set per template-v<N> version.
#
# Rule: edit this file, then recompile requirements.txt with
#   uv pip compile templates/base/requirements.in -o templates/base/requirements.txt \
#     --python-version 3.12
# Never hand-edit requirements.txt. The compiled file is the fully pinned transitive closure
# that manifests reference (template_version 1) and the Stage 3 base image installs.

pettingzoo
gymnasium
# Pinned exactly: the Flappy Bird overlay extractor reads this package's internals, which
# only a pinned version makes safe.
flappy-bird-gymnasium==0.4.0
numpy
pygame
python-dotenv
openai
