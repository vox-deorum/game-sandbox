{
  "name": "@game-sandbox/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Game Sandbox web frontend: the renderers, the live-play and replay hosts, and the Better Auth session client.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:local": "vite build --config vite.local.config.ts",
    "preview": "vite preview",
    "check": "biome check . && vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run e2e:build && npm run e2e:run",
    "e2e:build": "npm run build && npm run build:local",
    "e2e:run": "playwright test"
  },
  "dependencies": {
    "@game-sandbox/schema": "*",
    "@lucide/vue": "^1.21.0",
    "better-auth": "1.6.23",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.0",
    "pixi-tiledmap": "2.8.5",
    "pixi.js": "8.19.0",
    "reka-ui": "^2.9.10",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/vue": "^8.1.0",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.2.0"
  }
}
