# Keep the build context lean for both the manual session-base build and the app image build
# (Dockerfile, repo root). This mirrors the tar-fs ignore in backend/src/driver/docker/image.ts
# (the authoritative path the execution driver uses).
node_modules
**/node_modules
.git
.venv
build
data
**/data
dist
site
.tls
.pytest-tmp
.codex-pytest-budget-*
.test-tmp-*
.pytest-cache
.pytest_cache
.mypy_cache
.ruff_cache
**/__pycache__
**/*.pyc

# Local configuration may contain credentials. The committed defaults are safe build-context input.
.env
.env.*
!.env.default
