# Keep the build context lean for the app image build (Dockerfile, repo root). The session-base
# build packs only its registered input trees (backend/src/driver/docker/build-inputs.ts), so this
# file serves the repo-root deploy Dockerfile.
node_modules
**/node_modules
.git
.venv
build
data
**/data
dist
site
.tls
.pytest-tmp
.codex-pytest-budget-*
.test-tmp-*
.pytest-cache
.pytest_cache
.mypy_cache
.ruff_cache
**/__pycache__
**/*.pyc

# Local configuration may contain credentials. The committed defaults are safe build-context input.
.env
.env.*
!.env.default
