{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // Vue single-file components are excluded: Biome lints the script block but not the template, so
    // it false-flags bindings used only in the template. vue-tsc type-checks the .vue files instead;
    // Biome still owns every .ts/.tsx file in the frontend.
    // Test fixtures are data, not source: some are intentionally malformed (e.g. a deliberately
    // invalid manifest.json the static validator must reject), so Biome must not try to parse or
    // format them.
    "includes": [
      "**",
      "!**/generated",
      "!**/dist",
      "!**/node_modules",
      "!**/*.vue",
      "!**/test/fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    // Import isolation (Stage 3): every backend/src file matches exactly one override below, so the
    // restricted-import sets never have to merge. General backend code may not reach for Docker, the
    // database engine, child_process, or the git client; storage owns the database; the Docker driver
    // owns dockerode; the submission source resolver (Stage 5.2) owns the one allowed `simple-git`
    // dependency. The auth module (Stage 12) shares the storage layer's raw better-sqlite3 handle to
    // embed Better Auth on the same connection, so it alone among non-storage code may import
    // `better-sqlite3` (for the constructor argument's type); it still may not import `kysely`, since
    // Better Auth manages its own tables through its embedded adapter. A Kubernetes driver is then a
    // pure addition, and the Biome CI check enforces all of it.
    {
      "includes": [
        "**/backend/src/**",
        "!**/backend/src/storage/**",
        "!**/backend/src/auth/**",
        "!**/backend/src/driver/docker/**",
        "!**/backend/src/submission/source/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "dockerode": "Docker APIs belong only in backend/src/driver/docker/. Use the driver interface in backend/src/driver/index.ts so the Kubernetes driver stays a pure addition.",
                  "kysely": "The database layer lives only in backend/src/storage/. Import the Storage interface and the derived domain types from backend/src/storage instead.",
                  "better-sqlite3": "The database layer lives only in backend/src/storage/. Import the Storage interface and the derived domain types from backend/src/storage instead.",
                  "child_process": "Shelling out is denied across the backend; containers are controlled through the execution driver, not a CLI.",
                  "node:child_process": "Shelling out is denied across the backend; containers are controlled through the execution driver, not a CLI.",
                  "simple-git": "The git client lives only in backend/src/submission/source/. Import the SubmissionSource seam from backend/src/submission/source instead."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/backend/src/storage/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "dockerode": "Docker APIs belong only in backend/src/driver/docker/.",
                  "child_process": "Shelling out is denied across the backend.",
                  "node:child_process": "Shelling out is denied across the backend.",
                  "simple-git": "The git client lives only in backend/src/submission/source/."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/backend/src/auth/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "dockerode": "Docker APIs belong only in backend/src/driver/docker/.",
                  "kysely": "Better Auth manages its own tables through its embedded adapter; app queries go through the Storage interface in backend/src/storage.",
                  "child_process": "Shelling out is denied across the backend.",
                  "node:child_process": "Shelling out is denied across the backend.",
                  "simple-git": "The git client lives only in backend/src/submission/source/."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/backend/src/driver/docker/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "kysely": "The database layer lives only in backend/src/storage/.",
                  "better-sqlite3": "The database layer lives only in backend/src/storage/.",
                  "child_process": "Shelling out is denied across the backend; use dockerode's API, not the docker CLI.",
                  "node:child_process": "Shelling out is denied across the backend; use dockerode's API, not the docker CLI.",
                  "simple-git": "The git client lives only in backend/src/submission/source/."
                }
              }
            }
          }
        }
      }
    },
    // The submission source resolver (Stage 5.2) is the one place the `simple-git` dependency is
    // allowed: it drives the non-interactive `git` binary to resolve and fetch participant
    // repositories. Raw `child_process` is still banned even here (use simple-git, not the CLI
    // directly), as are Docker and the database engine — the carve-out is for simple-git, not a
    // general escape hatch. The GitHub reachability client uses the global `fetch`, which is
    // unimportable and therefore confined by file location plus the CI grep, not a restricted import.
    {
      "includes": ["**/backend/src/submission/source/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "dockerode": "Docker APIs belong only in backend/src/driver/docker/.",
                  "kysely": "The database layer lives only in backend/src/storage/.",
                  "better-sqlite3": "The database layer lives only in backend/src/storage/.",
                  "child_process": "Drive git through simple-git, not a raw child_process spawn.",
                  "node:child_process": "Drive git through simple-git, not a raw child_process spawn."
                }
              }
            }
          }
        }
      }
    }
  ]
}
