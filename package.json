{
  "name": "game-sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Game Sandbox monorepo workspace root.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "schema/ts"
  ],
  "scripts": {
    "generate": "uv run python scripts/generate.py",
    "check": "uv run python scripts/ci.py check",
    "test": "uv run python scripts/ci.py test",
    "check:py": "uv run ruff check . && uv run ruff format --check . && uv run pyright",
    "check:ts": "npm run --workspace @game-sandbox/schema check",
    "test:py": "uv run pytest",
    "test:ts": "npm run --workspace @game-sandbox/schema test"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4"
  }
}
