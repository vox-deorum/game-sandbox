{
  "palette": {
    "backdrop": "#101816",
    "parchment": "#cfc5a9",
    "bone": "#efe7d3",
    "ink": "#6f6757",
    "reed": "#a9ae8a",
    "silt": "#bfa072",
    "water": "#5a7680",
    "pine": "#4f6a4b",
    "indigo": "#27436b",
    "cinnabar": "#b0402e",
    "gilt": "#d9a441",
    "violet": "#6b5d72",
    "timber": "#8a6246"
  },
  "transition": { "naturalMs": 1000, "settleGraceMs": 100 },
  "terrain": {
    "fills": {
      "ground": { "frames": ["washA", "washB", "washC", "washD"], "tint": "reed", "opacity": 1 },
      "road": {
        "frames": ["roadA", "roadB", "roadC", "roadD"],
        "tint": "silt",
        "tintMix": { "tint": "timber", "amount": 0.2 },
        "detailShift": 0.12,
        "opacity": 1,
        "offsetPassOpacity": 0
      },
      "path": {
        "frames": ["roadA", "roadB", "roadC", "roadD"],
        "tint": "parchment",
        "opacity": 1,
        "offsetPassOpacity": 0
      },
      "bridge": {
        "frames": ["rippleA", "rippleB", "rippleC", "rippleD"],
        "tint": "water",
        "opacity": 1
      },
      "interior": {
        "frames": ["floorA", "floorB", "floorC", "floorD"],
        "tint": "parchment",
        "opacity": 1
      },
      "doorway": { "frames": ["doorway"], "tint": "bone", "opacity": 1 },
      "field": {
        "frames": ["furrowA", "furrowB", "furrowC", "furrowD"],
        "tint": "gilt",
        "opacity": 1
      },
      "reeds": {
        "frames": ["reedsA", "reedsB", "reedsC", "reedsD"],
        "tint": "reed",
        "tintMix": { "tint": "pine", "amount": 0.45 },
        "detailShift": 0.2,
        "opacity": 1
      },
      "water": {
        "frames": ["rippleA", "rippleB", "rippleC", "rippleD"],
        "tint": "water",
        "opacity": 1
      },
      "wall": { "frames": ["floorA", "floorB", "floorC", "floorD"], "tint": "indigo", "opacity": 1 }
    },
    "contours": {
      "profiles": {
        "land": {
          "sampleSpacingCells": 0.25,
          "cornerRadiusCells": 0.8,
          "octaves": [
            { "wavelengthCells": 9, "amplitudeCells": 0.2 },
            { "wavelengthCells": 4.5, "amplitudeCells": 0.14 }
          ]
        },
        "water": {
          "sampleSpacingCells": 0.2,
          "cornerRadiusCells": 0.8,
          "octaves": [
            { "wavelengthCells": 11, "amplitudeCells": 0.22 },
            { "wavelengthCells": 5, "amplitudeCells": 0.15 }
          ]
        }
      },
      "junctionTangentCells": 0.15,
      "maxDeviationCells": 0.6
    },
    "seams": {
      "pooling": { "widthCells": 0.45, "darken": 0.16, "opacity": 0.28 },
      "ink": {
        "tint": "ink",
        "widthCells": 0.15,
        "opacity": 0.7,
        "runLengthCells": [4, 9],
        "gapLengthCells": [0.6, 1.7]
      },
      "waterHatch": {
        "tint": "ink",
        "widthCells": 0.1,
        "offsetsCells": [0.55, 1.05],
        "opacity": 0.3,
        "bridgeTaperCells": 0.35
      }
    },
    "reedMarks": {
      "tint": "pine",
      "widthCells": 0.05,
      "lengthCells": [0.25, 0.5],
      "perCell": 3,
      "opacity": 0.5
    },
    "routes": {
      "road": {
        "curve": {
          "sampleSpacingCells": 0.25,
          "cornerRadiusCells": 0.56,
          "octaves": [{ "wavelengthCells": 6, "amplitudeCells": 0.05 }]
        },
        "targetWidthCells": 2.1,
        "minimumWidthCells": 1.6,
        "edgeFadeCells": 0.05,
        "opacity": 1
      },
      "path": {
        "curve": {
          "sampleSpacingCells": 0.2,
          "cornerRadiusCells": 0.53,
          "octaves": [{ "wavelengthCells": 7, "amplitudeCells": 0.04 }]
        },
        "widthCells": 0.7,
        "edgeFadeCells": 0.01,
        "opacity": 1
      }
    },
    "planks": {
      "horizontal": "bridgeA",
      "vertical": "bridgeB",
      "compact": "bridgeC",
      "tint": "timber",
      "shadowTint": "backdrop",
      "shadowOpacity": 0.25,
      "shadowOffsetCells": 0.06,
      "textureBleedCells": 0.025
    },
    "upperWall": { "frames": ["wallA", "wallB", "wallC", "wallD"], "tint": "indigo" }
  },
  "roofs": {
    "clearAlpha": 0.18,
    "fadeMs": 220,
    "frames": {
      "home": ["homeFill", "homeEdge", "homeCorner", "homeRidge"],
      "inn": ["innFill", "innEdge", "innCorner", "innRidge"],
      "shed": ["shedFill", "shedEdge", "shedCorner", "shedRidge"]
    }
  },
  "postEffects": {
    "authoredGrade": {
      "brightness": 1.02,
      "contrast": 0.88,
      "saturation": 0.8,
      "tint": "parchment",
      "tintMix": 0.2
    },
    "nightGrade": {
      "brightness": 0.7,
      "contrast": 1.08,
      "saturation": 0.7,
      "tint": "indigo",
      "tintMix": 0.18
    },
    "propContactShadow": {
      "tint": "backdrop",
      "opacity": 0.18,
      "widthFactor": 0.92,
      "heightFactor": 0.58,
      "offsetYCells": 0.03
    }
  },
  "characters": {
    "clothingTints": ["reed", "pine", "indigo", "violet", "parchment", "timber"],
    "details": ["hairKnot", "reedCap", "headscarf"],
    "walk": { "frames": ["rest", "leftForward", "pass", "rightForward"], "frameRatio": 0.68 },
    "visitor": { "detail": "visitorTie", "tint": "cinnabar" }
  },
  "props": {
    "defaultScale": 0.14,
    "scaleByType": { "bell": 0.36, "pump": 0.33 },
    "effectAnchorByType": { "pump": { "x": 31, "y": -61 } },
    "monumentByType": {
      "pump": {
        "textureDensityDivisor": 4,
        "sourceAnchorByRole": { "still": { "x": 344, "y": 384 } }
      },
      "bell": {
        "textureDensityDivisor": 8,
        "sourceAnchorByRole": {
          "still": { "x": 384, "y": 480 },
          "foundation": { "x": 384, "y": 256 }
        }
      }
    }
  },
  "scenery": { "defaultScale": 0.25, "scaleByType": { "crate": 0.3 } },
  "propEffects": {
    "lantern": {
      "frames": ["glowFlicker", "glowLow", "glowHigh", "glow", "glowHigh", "glowLow"],
      "frameRate": 0.5
    },
    "hearth": {
      "frames": ["flameA", "flameE", "flameB", "flameC", "flameF", "flameD"],
      "frameRate": 1
    },
    "shrine": {
      "frames": ["smokeA", "smokeC", "smokeD", "smokeB", "smokeD", "smokeC"],
      "frameRate": 0.5
    },
    "pump": {
      "frames": ["waterA", "waterC", "waterD", "waterB", "waterD", "waterC"],
      "frameRate": 1
    },
    "bell": {
      "frames": [
        "bellLinesC",
        "bellLinesA",
        "bellLinesD",
        "bellLinesB",
        "bellLinesE",
        "bellLinesF"
      ],
      "frameRate": 1.5
    }
  },
  "emissives": { "lantern": "gilt", "hearth": "cinnabar", "frame": "glow" },
  "cranes": { "frames": ["craneA", "craneB"], "tint": "bone", "count": [1, 3], "frameMs": 260 },
  "expressions": {
    "frames": {
      "wave": "expressionWave",
      "nod": "expressionNod",
      "shake_head": "expressionShakeHead",
      "point": "expressionPoint",
      "laugh": "expressionLaugh",
      "shrug": "expressionShrug",
      "startle": "expressionStartle",
      "sleep": "expressionSleep",
      "sweep": "expressionSweep",
      "use": "expressionUse"
    },
    "tint": "ink",
    "accentFrames": ["expressionAccentA", "expressionAccentB"],
    "frameRatio": 0.25
  }
}
