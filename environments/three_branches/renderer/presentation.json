{
  "palette": {
    "backdrop": "#101816",
    "parchment": "#cfc5a9",
    "bone": "#efe7d3",
    "ink": "#6f6757",
    "reed": "#a9ae8a",
    "silt": "#bfa072",
    "water": "#5a7680",
    "pine": "#4f6a4b",
    "indigo": "#27436b",
    "cinnabar": "#b0402e",
    "gilt": "#d9a441",
    "violet": "#6b5d72",
    "timber": "#8a6246"
  },
  "transition": { "naturalMs": 1000, "settleGraceMs": 100 },
  "terrain": {
    "fills": {
      "ground": { "frames": ["washA", "washB", "washC", "washD"], "tint": "reed", "opacity": 1 },
      "road": { "frames": ["roadA", "roadB", "roadC", "roadD"], "tint": "timber", "opacity": 0.58 },
      "path": { "frames": ["roadA", "roadB", "roadC", "roadD"], "tint": "parchment", "opacity": 1 },
      "bridge": { "frames": ["rippleA", "rippleB", "rippleC", "rippleD"], "tint": "water", "opacity": 1 },
      "interior": { "frames": ["floorA", "floorB", "floorC", "floorD"], "tint": "parchment", "opacity": 1 },
      "doorway": { "frames": ["doorway"], "tint": "bone", "opacity": 1 },
      "field": { "frames": ["furrowA", "furrowB", "furrowC", "furrowD"], "tint": "silt", "opacity": 1 },
      "reeds": { "frames": ["reedsA", "reedsB", "reedsC", "reedsD"], "tint": "reed", "opacity": 1 },
      "water": { "frames": ["rippleA", "rippleB", "rippleC", "rippleD"], "tint": "water", "opacity": 1 },
      "wall": { "frames": ["floorA", "floorB", "floorC", "floorD"], "tint": "indigo", "opacity": 1 }
    },
    "contours": {
      "smoothingPasses": 2,
      "cornerWeight": 0.25,
      "sampleSpacingCells": 0.5,
      "junctionTangentCells": 0.25,
      "noiseAmplitudeCells": 0.06,
      "noiseWavelengthCells": [1.5, 3],
      "maxDeviationCells": 0.15,
      "saddleRadiusCells": 0.08,
      "shoreline": {
        "bands": [
          { "tint": "reed", "widthCells": 0.32, "opacity": 0.16 },
          { "tint": "silt", "widthCells": 0.16, "opacity": 0.36 }
        ],
        "bridgeTaperCells": 0.25
      }
    },
    "planks": { "horizontal": "bridgeA", "vertical": "bridgeB", "compact": "bridgeC", "tint": "timber" },
    "upperWall": { "frames": ["wallA", "wallB", "wallC", "wallD"], "tint": "indigo" }
  },
  "roofs": {
    "clearAlpha": 0.18,
    "fadeMs": 220,
    "frames": {
      "home": ["homeFill", "homeEdge", "homeCorner", "homeRidge"],
      "inn": ["innFill", "innEdge", "innCorner", "innRidge"],
      "shed": ["shedFill", "shedEdge", "shedCorner", "shedRidge"]
    }
  },
  "phaseGrades": {
    "dawn": { "brightness": 0.96, "contrast": 0.98, "saturation": 0.9, "tint": "violet" },
    "morning": { "brightness": 1, "contrast": 1, "saturation": 1, "tint": "parchment" },
    "midday": { "brightness": 1.04, "contrast": 1.02, "saturation": 1.04, "tint": "bone" },
    "evening": { "brightness": 0.92, "contrast": 1.03, "saturation": 0.9, "tint": "silt" },
    "night": { "brightness": 0.7, "contrast": 1.08, "saturation": 0.7, "tint": "indigo" }
  },
  "characters": {
    "clothingTints": ["reed", "pine", "indigo", "violet", "parchment", "timber"],
    "details": ["hairKnot", "reedCap", "headscarf"],
    "walk": { "frames": ["rest", "leftForward", "pass", "rightForward"], "frameMs": 170 },
    "visitor": { "detail": "visitorTie", "tint": "cinnabar" }
  },
  "propEffects": {
    "lantern": ["glow", "glowFlicker"],
    "hearth": ["flameA", "flameB", "flameC", "flameD"],
    "shrine": ["smokeA", "smokeB"],
    "pump": ["waterA", "waterB"],
    "bell": ["bellLinesA", "bellLinesB"]
  },
  "emissives": { "lantern": "gilt", "hearth": "cinnabar", "frame": "glow" },
  "cranes": { "frames": ["craneA", "craneB"], "tint": "bone", "count": [1, 3], "frameMs": 260 }
}
