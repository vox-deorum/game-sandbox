# Tracked runtime defaults. Put private credentials and machine-specific overrides in `.env`.
# The full variable reference lives in docs/contributors/setup/configuration.md.

# Server and sessions
PORT=8080
SITE_NAME="Game Sandbox"
DATA_DIR=backend/data
SESSION_IDLE_TIMEOUT_MS=60000
SANDBOX_CPUS=1
SANDBOX_MEMORY_MB=512
SANDBOX_MEMORY_PER_PLAYER_MB=32
SANDBOX_SCRATCH_MB=256

# These credentials are public and local-only. The opt-in forces a loopback listener.
AUTH_ALLOW_INSECURE_DEFAULTS=true
PUBLIC_ORIGIN=http://localhost:8080
AUTH_SECRET=dev-secret-do-not-deploy-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-dev-password
ADMIN_NAME=Admin

# Execution and frontend
EXECUTION_DRIVER=docker
DOCKER_IMAGE_TAG_PREFIX=game-sandbox
DOCKER_IMAGE_POLICY=reuse
# LLM sandboxes relay through the host process by default. Compose deployments use compose-network
# with an explicitly named shared network and the backend service hostname.
DOCKER_LLM_RELAY_MODE=host-gateway
FRONTEND_DIST=frontend/dist
DOCS_DIR=docs
# Keep this repository in sync with DEFAULT_TARGET_REPO in scripts/publish_template.py.
TEMPLATE_REPO_URL=https://github.com/vox-deorum/game-agent-template

# Recordings
RECORDING_RETENTION_DAYS=30
RECORDING_USER_QUOTA=100
RECORDING_SWEEP_INTERVAL_MS=3600000

# LLM proxy limits. The proxy remains disabled until `.env` supplies LLM_UPSTREAM_URL and at least
# one LLM_MODEL_* alias.
LLM_INTERNAL_PORT=8081
LLM_UPSTREAM_TIMEOUT_MS=30000
LLM_UPSTREAM_MAX_RETRIES=2
LLM_TIKTOKEN_ENCODING=cl100k_base
LLM_DEFAULT_MAX_OUTPUT_TOKENS=1024
LLM_MAX_OUTPUT_TOKENS=4096
LLM_COST_WEIGHT_LARGE=4
LLM_COST_WEIGHT_MEDIUM=2
LLM_COST_WEIGHT_SMALL=1
LLM_SESSION_TOKEN_BUDGET=100000
LLM_SESSION_RATE_LIMIT_RPM=60
LLM_DEVELOPMENT_TOKEN_BUDGET=100000
LLM_DEVELOPMENT_RATE_LIMIT_RPM=30

# Submissions
ALLOW_LOCAL_SUBMISSIONS=false
SUBMISSION_GIT_TIMEOUT_MS=15000
SUBMISSION_BUILD_TIMEOUT_MS=120000
SUBMISSION_LOAD_CHECK_TIMEOUT_MS=30000
SUBMISSION_MAX_SIZE_MB=25
OVERLAY_IMAGE_BUDGET=50
OVERLAY_IMAGE_SWEEP_INTERVAL_MS=3600000
