{
  "name": "@game-sandbox/schema",
  "version": "0.1.0",
  "private": true,
  "description": "The canonical zod definition of the Game Sandbox state schema, plus the shared wire shapes the browser speaks.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts",
    "./schedule": "./src/schedule.ts",
    "./environment": "./src/environment.ts",
    "./accounts": "./src/accounts.ts",
    "./board": "./src/board.ts",
    "./llm": "./src/llm.ts",
    "./seasons": "./src/seasons.ts",
    "./text": "./src/text.ts",
    "./version": "./src/version.ts"
  },
  "scripts": {
    "check": "biome check . && tsc --noEmit",
    "generate": "tsx scripts/emit-json-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
